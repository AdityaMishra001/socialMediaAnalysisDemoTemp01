# LLM Configuration
# Supports OpenAI, OpenAI-compatible APIs (e.g. OpenRouter, Ollama, Groq), or Gemini OpenAI compatibility
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Database Configuration (defaults to SQLite if not provided)
# For SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./feedback_ai.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/feedbackai

# App Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
